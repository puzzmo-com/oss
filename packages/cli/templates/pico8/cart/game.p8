pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- countdown: the puzzle is a
-- number, press ❎ until it
-- reaches zero.
#include puzzmo.lua

function _init()
 pz_init()
end

-- the puzzle has arrived
function pz_on_ready()
 total=tonum(pz.puzzle)
 -- what we saved last time, if
 -- the player is coming back
 presses=tonum(pz.progress) or 0
 win_t=0
end

function pz_on_retry()
 presses,win_t=0,0
end

function _update60()
 pz_update()
 if (not pz.ready) return
 if win_t>0 then
  win_t+=1
  -- celebrated long enough
  if (win_t==60) pz_finished()
 elseif pz.started and not pz.paused
  and not pz.completed and btnp(❎) then
  presses+=1
  pz_save(presses)
  if presses>=total then
   pz_complete(total,presses)
   win_t=1
  end
 end
end

function _draw()
 cls(1)
 if not pz.ready then
  print("waiting for a puzzle",24,60,6)
  return
 end
 local s=tostr(max(total-presses,0))
 local c=pz.completed and 11 or 7
 print("\^w\^t"..s,64-#s*4,56,c)
 print("❎ count down",38,110,6)
end
