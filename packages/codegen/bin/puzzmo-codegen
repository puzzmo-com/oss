#!/usr/bin/env node
// Thin launcher for the native binary. Exits 3 when no binary exists for this platform or it
// could not be started, which callers should read as "codegen is unavailable here".
const { spawnSync } = require("node:child_process")

const { resolveBinary } = require("../resolve.js")

const binary = resolveBinary()
if (!binary) {
  console.error(`puzzmo-codegen: no prebuilt binary for ${process.platform}-${process.arch}`)
  process.exit(3)
}

const { status, signal, error } = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" })
if (error) {
  console.error(`puzzmo-codegen: could not run ${binary}: ${error.message}`)
  process.exit(3)
}

// A signal means the binary crashed or was killed. Reporting that as 3 would read as "no binary",
// so it gets its own code outside the ones the CLI itself uses.
if (signal) {
  console.error(`puzzmo-codegen: ${binary} was terminated by ${signal}`)
  process.exit(4)
}

process.exit(status ?? 4)
