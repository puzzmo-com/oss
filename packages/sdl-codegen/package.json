{
  "name": "@sdl-codegen/node",
  "version": "3.0.4",
  "description": "GraphQL .d.ts file generation for SDL-first projects",
  "license": "MIT",
  "author": "Orta Therox <orta.therox@gmail.com>",
  "type": "module",
  "private": true,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/generator": "7.26.0",
    "@babel/parser": "^7.26.2",
    "@babel/traverse": "7.25.9",
    "@babel/types": "7.26.0",
    "@mrleebo/prisma-ast": "0.13.1",
    "ts-morph": "^22.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.14.0",
    "@types/node": "^25.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "graphql": "*"
  }
}
