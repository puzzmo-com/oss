{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "types": ["node"],
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "lib",
    // Matches what tsc inferred before TS 7, which now requires it to be explicit (TS5011)
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2021"
  },
  "exclude": ["node_modules", "src/tests"],
  "include": ["src"]
}
